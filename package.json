{
  "name": "orca-agent-map",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "sh scripts/orca.sh plugin validate . && sh scripts/orca.sh plugin test . && sh scripts/orca.sh plugin check .",
    "build": "sh scripts/orca.sh plugin types . && tsc -p ."
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.2"
  }
}
